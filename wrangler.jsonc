{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gorbagana-docs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gorbagana-docs",
    },
  ],
  // Attach docs.gorbagana.wtf via dashboard, OR uncomment after freeing the hostname:
  // "routes": [{ "pattern": "docs.gorbagana.wtf", "custom_domain": true }]
}
